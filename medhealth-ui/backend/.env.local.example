# Copy to backend/.env.local for localhost-only overrides.
# This file is intentionally safe to commit; backend/.env.local is ignored.

# Local UI/testing mode without PostgreSQL:
MEDHEALTH_STORE_MODE=inmemory

# Optional:
# MEDHEALTH_HOST=0.0.0.0
# MEDHEALTH_PORT=8001

# PostgreSQL mode example:
# MEDHEALTH_STORE_MODE=persistent
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/billing
